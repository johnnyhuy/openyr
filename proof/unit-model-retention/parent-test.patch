+#[test]
+fn unit_model_parent_history_regression() {
+ let mut bank=voxel_bank();
+ for i in 0..300 {
+ assert!(bank.get(&format!("TYPE{i}"),0,[80,160,240]).is_some());
+ assert!(bank.voxels.len() <= 128, "retained {} records at type {i}",bank.voxels.len());
+ }
